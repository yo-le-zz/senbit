#!/bin/sh
# Called by apt before each upgrade (/etc/apt/apt.conf.d/50senbit-update): takes an
# automatic snapshot to come back to. The work is done by the `snapshot` command
# (configuration, package list, versions, boot files record); only the last 3 automatic
# snapshots are kept, the ones created by hand never are.
#
# The boot files of the previous version are kept by the senbit-kernel package
# (/boot/vmlinuz.old): see `rollback`.
[ -x /usr/sbin/snapshot ] && /usr/sbin/snapshot create --auto
exit 0
