#!/bin/sh
# Counts the Senbit files that differ from what the packages installed, and writes the
# number to /run/senbit/integrity (read by the login banner). Run once per boot by
# senbit-integrity.service. The details are in: bootreport --verify
#
# `dpkg --verify` prints one line per difference: "??5?????? /usr/sbin/rollback", or
# "??5?????? c /etc/..." for a configuration file (changing those is allowed: skipped).
out_dir="${INTEGRITY_DIR:-/run/senbit}"
dpkg="${DPKG:-dpkg}"

mkdir -p "$out_dir"
count="$("$dpkg" --verify senbit-kernel senbit-userspace 2>/dev/null | awk '$2 != "c"' | grep -c . || true)"
printf '%s\n' "${count:-0}" > "$out_dir/integrity"
exit 0
