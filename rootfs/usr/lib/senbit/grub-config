#!/bin/sh
# grub-config UUID - writes /boot/grub/grub.cfg (and the grubenv block).
#
# Single source of truth for the boot menu: the installer calls it on the new
# system, and the senbit-kernel package calls it when an older installation has
# no boot counter yet. ROOT=/mnt/target sh grub-config UUID  writes under /mnt/target.
#
# Automatic rollback (senbit-boot-counter):
#   - GRUB counts every boot attempt in the `boot_tries` variable of grubenv;
#   - senbit-boot-ok.service resets it once the new system is up and running;
#   - when the counter reaches 3 (the system did not come up three times in a
#     row) and a previous version exists (/boot/vmlinuz.old, kept by the
#     senbit-kernel package), GRUB boots the previous version by default and passes
#     senbit.fallback=1 on its command line: once that boot works, boot-ok runs
#     `rollback --commit` so that the previous version stays the default;
#   - "Senbit (recovery)" boots to a root shell (systemd rescue.target) and does not
#     count as a failed boot;
#   - every entry has panic=10: after a kernel panic the machine reboots by itself
#     after 10 seconds, so the boot counter and the rollback can do their work.
set -e

uuid="$1"
root="${ROOT:-}"

if [ -z "$uuid" ]; then
    echo "usage: grub-config UUID" >&2
    exit 1
fi

grub_dir="$root/boot/grub"
mkdir -p "$grub_dir"

# grubenv: exactly 1024 bytes, starts with the signature line, padded with '#'.
if [ ! -f "$grub_dir/grubenv" ]; then
    { printf '# GRUB Environment Block\n'; head -c 1024 /dev/zero | tr '\0' '#'; } \
        | head -c 1024 > "$grub_dir/grubenv"
fi

cat > "$grub_dir/grub.cfg" <<CFG
# senbit-boot-counter v3 (generated by /usr/lib/senbit/grub-config, do not edit)
set timeout=5
set default=0
terminal_output console
set gfxpayload=keep

# senbit_fallback=1 only when GRUB itself chose the previous version (3 failed boots):
# senbit-boot-ok.service then makes this choice permanent (rollback --commit).
set senbit_fallback=0

# Boot attempts since the last successful boot (reset by senbit-boot-ok.service).
load_env boot_tries
if [ -z "\${boot_tries}" ]; then
    set boot_tries=1
elif [ "\${boot_tries}" = "1" ]; then
    set boot_tries=2
else
    set boot_tries=3
fi
save_env boot_tries

# Three attempts without a working system: boot the previous version.
if [ "\${boot_tries}" = "3" ]; then
    if [ -f /boot/vmlinuz.old ]; then
        set default=1
        set senbit_fallback=1
    fi
fi

menuentry "Senbit" {
    linux /boot/vmlinuz root=UUID=$uuid rw console=ttyS0,115200 console=tty0 loglevel=3 net.ifnames=0 biosdevname=0 panic=10
    initrd /boot/initramfs.cpio.gz
}

if [ -f /boot/vmlinuz.old ]; then
    menuentry "Senbit (previous version)" {
        linux /boot/vmlinuz.old root=UUID=$uuid rw console=ttyS0,115200 console=tty0 loglevel=3 net.ifnames=0 biosdevname=0 panic=10 senbit.fallback=\${senbit_fallback}
        initrd /boot/initramfs.cpio.gz.old
    }
fi

# Recovery: a root shell with the services stopped (the root password is asked).
# The attempt counter is reset: choosing this entry is not a failed boot, and it must
# not make GRUB fall back to the previous version at the next normal boot.
menuentry "Senbit (recovery)" {
    set boot_tries=
    save_env boot_tries
    linux /boot/vmlinuz root=UUID=$uuid rw console=ttyS0,115200 console=tty0 loglevel=3 net.ifnames=0 biosdevname=0 panic=10 systemd.unit=rescue.target
    initrd /boot/initramfs.cpio.gz
}
CFG
