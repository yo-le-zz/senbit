#!/bin/sh
# Called by senbit-boot-ok.service once the system is up: the boot succeeded, so
# GRUB's attempt counter goes back to zero (see grub-config). Without this the
# counter would reach 3 and GRUB would boot the previous version.
env_file=/boot/grub/grubenv

# GRUB went back to the previous version by itself (3 failed boots): keep that choice,
# otherwise the next boot would try the faulty version again.
if grep -q 'senbit\.fallback=1' /proc/cmdline 2>/dev/null && [ -x /usr/sbin/rollback ]; then
    /usr/sbin/rollback --commit >/dev/null 2>&1 || true
fi

[ -f "$env_file" ] || exit 0

if command -v grub-editenv >/dev/null 2>&1; then
    grub-editenv "$env_file" unset boot_tries
    exit $?
fi

# No grub-editenv: rewrite the block without the variable (grubenv = 1024 bytes).
tmp="$env_file.tmp"
{
    grep -a -v '^boot_tries=' "$env_file" | grep -a -v '^#*$'
    printf '#'
} > "$tmp" 2>/dev/null || exit 0
{ head -c 1024 "$tmp"; head -c 1024 /dev/zero | tr '\0' '#'; } | head -c 1024 > "$env_file"
rm -f "$tmp"
