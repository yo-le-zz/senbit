# Senbit default firewall (nftables). Loaded by senbit-firewall.service when nftables is
# installed: sudo apt install nftables
#
# Inbound traffic is denied except what is listed here. Outbound traffic is not restricted.
# Documentation: docs/SECURITY.md
#
# To open a port, do NOT edit this file: add a file to /etc/senbit/firewall.d/, for example
#   add rule inet senbit input tcp dport 80 accept
# then reload: sudo systemctl reload senbit-firewall

add table inet senbit
flush table inet senbit

table inet senbit {
    chain input {
        type filter hook input priority filter; policy drop;

        # Answers to what this machine started, and nothing malformed.
        ct state established,related accept
        ct state invalid drop

        # The machine talking to itself.
        iifname "lo" accept

        # ping and, for IPv6, neighbour discovery: without them the network breaks.
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # DHCP client (the lease renewal comes back to port 68).
        udp dport 68 accept

        # SSH. Nothing listens on it until openssh-server is installed.
        tcp dport 22 accept
    }
}

# Rules added by the administrator (executed after the table above exists).
include "/etc/senbit/firewall.d/*.nft"
