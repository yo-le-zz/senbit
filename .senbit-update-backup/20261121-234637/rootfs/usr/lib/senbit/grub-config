#!/bin/sh
# grub-config UUID - writes /boot/grub/grub.cfg (and the grubenv block).
#
# Single source of truth for the boot menu: the installer calls it on the new
# system, and the senbit-kernel package calls it when an older installation has
# no boot counter yet. ROOT=/mnt/target sh grub-config UUID  writes under /mnt/target.
#
# Automatic rollback (senbit-boot-counter):
#   - GRUB counts every boot attempt in the `boot_tries` variable of grubenv;
#   - senbit-boot-ok.service resets it once the new system is up and running;
#   - when the counter reaches 3 (the system did not come up three times in a
#     row) and a previous version exists (/boot/vmlinuz.old, kept by the
#     senbit-kernel package), GRUB boots the previous version by default.
set -e

uuid="$1"
root="${ROOT:-}"

if [ -z "$uuid" ]; then
    echo "usage: grub-config UUID" >&2
    exit 1
fi

grub_dir="$root/boot/grub"
mkdir -p "$grub_dir"

# grubenv: exactly 1024 bytes, starts with the signature line, padded with '#'.
if [ ! -f "$grub_dir/grubenv" ]; then
    { printf '# GRUB Environment Block\n'; head -c 1024 /dev/zero | tr '\0' '#'; } \
        | head -c 1024 > "$grub_dir/grubenv"
fi

cat > "$grub_dir/grub.cfg" <<CFG
# senbit-boot-counter (generated by /usr/lib/senbit/grub-config, do not edit)
set timeout=5
set default=0
terminal_output console
set gfxpayload=keep

# Boot attempts since the last successful boot (reset by senbit-boot-ok.service).
load_env boot_tries
if [ -z "\${boot_tries}" ]; then
    set boot_tries=1
elif [ "\${boot_tries}" = "1" ]; then
    set boot_tries=2
else
    set boot_tries=3
fi
save_env boot_tries

# Three attempts without a working system: boot the previous version.
if [ "\${boot_tries}" = "3" ]; then
    if [ -f /boot/vmlinuz.old ]; then
        set default=1
    fi
fi

menuentry "Senbit" {
    linux /boot/vmlinuz root=UUID=$uuid rw console=ttyS0,115200 console=tty0 loglevel=3 net.ifnames=0 biosdevname=0
    initrd /boot/initramfs.cpio.gz
}

if [ -f /boot/vmlinuz.old ]; then
    menuentry "Senbit (previous version)" {
        linux /boot/vmlinuz.old root=UUID=$uuid rw console=ttyS0,115200 console=tty0 loglevel=3 net.ifnames=0 biosdevname=0
        initrd /boot/initramfs.cpio.gz.old
    }
fi
CFG
