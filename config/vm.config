# Senbit virtual machine configuration

RAM=2048M
CPUS=2

# QEMU CPU model. "host" gives the VM the instructions of the real CPU (KVM): with
# the default model (qemu64), programs built for x86-64-v2/v3 (kite, many
# Rust/Go/LLVM binaries) stop with "CPU ISA level is lower than required".
CPU=host

DISK=build/vm/senbit.qcow2
DISK_SIZE=10G
DISK_FORMAT=qcow2

NETWORK=user

# bios for legacy mode
# uefi for modern mode
BOOT=uefi
