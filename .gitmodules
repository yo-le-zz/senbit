# Senbit sources (Linux, BusyBox, util-linux, Parted, systemd) are NOT
# submodules: `devtool get` downloads them at the versions pinned in
# config/<name>/version and verifies the commit / sha256. See docs/BUILD.md.
[submodule "tools/keymaps/kbd"]
	path = tools/keymaps/kbd
	url = https://github.com/legionus/kbd.git
